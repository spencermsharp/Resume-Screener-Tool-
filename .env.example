# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# .env is git-ignored, so your secrets stay off version control.
#
# In production, set these same variables in your host's dashboard
# (Vercel / Render / Fly / AWS, etc.) instead of using a .env file.

# Your Anthropic API key — from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model (defaults to claude-sonnet-4-5).
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: port (defaults to 3200).
# PORT=3200

# Session secret for the login. MUST be a long random value in prod.
# SECRET_KEY=change-me-to-a-random-string

# Supabase (for cloud auth). Public values — safe to expose to the browser.
# Leave blank for local dev (no login wall). Set these in Railway for production.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
